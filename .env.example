LLM_PROVIDER=groq

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_BATCH_SIZE=32
EMBEDDING_BATCH_SIZE=32
MAX_CONTEXT_CHARS=6000
RAG_TOP_K=3
TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.6
SIMILARITY_THRESHOLD=0.6
RAG_CHUNK_SIZE_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=200

CORS_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=

# Optional fallback if FAISS artifacts are too large to commit.
INDEX_ARTIFACT_URL=
METADATA_ARTIFACT_URL=
